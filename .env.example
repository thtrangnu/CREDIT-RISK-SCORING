# Copy to .env (never commit the real .env). This project runs its own MySQL container,
# mapped to port 3307 rather than 3306 so it does not clash with a local MySQL install.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=home_credit
MYSQL_USER=app
MYSQL_PASSWORD=change_me_app
MYSQL_HOST_PORT=3307

DATABASE_URL=mysql+pymysql://app:change_me_app@localhost:3307/home_credit
MODEL_VERSION=v1-block2-5-isotonic
CORS_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=http://localhost:8000
