.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# The leading slash is MANDATORY: a bare "data/" pattern matches a directory named
# data at ANY depth, which silently swallowed backend/app/data/ and left those 3 files
# uncommitted.
/data/

# Artifacts: commit the small ones that tell the story (README and the model card link
# to them), skip the heavy ones that can be regenerated by rerunning the pipeline.
ml/artifacts/*
!ml/artifacts/.gitkeep
!ml/artifacts/model_card.md
!ml/artifacts/metrics_summary.json
!ml/artifacts/shap_global_importance.csv
!ml/artifacts/feature_names.json

*.egg-info/
.venv/
venv/

.env
node_modules/
frontend/dist/
backend/.pytest_cache/
mysql_# The leading slash is MANDATORY: a bare "data/" pattern matches a directory named
# data at ANY depth, which silently swallowed backend/app/data/ and left those 3 files
# uncommitted.
/data/

